# ==============================================================================
# PULSESEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# For local container: postgresql://postgres:postgres@localhost:5433/dispatch_db?schema=public
# Or default: postgresql://postgres:postgres@localhost:5432/pulsesend_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dispatch_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Security & Encryption (32-byte hex or random strings)
SESSION_SECRET=pulsesend_session_secret_super_secure_key_12345
ENCRYPTION_SECRET=pulsesend_aes256_encryption_master_key_32chars!!

# Worker Engine Settings
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_SECONDS=2

# Ethereal Email (Auto-generated on startup if left blank)
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# Google OAuth 2.0 Credentials (Set to enable live Google Sign-in)
# If blank, PulseSend activates developer mock mode for offline testing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack App OAuth Credentials (Set to enable live Slack OAuth & notifications)
# If blank, Slack service runs in mock mode for offline testing
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback

